{
  "version": 2,
  "builds": [
    {
      "src": "student.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "README.md",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "student.html"
    },
    {
      "src": "/dashboard",
      "dest": "dashboard.html"
    }
  ]
}